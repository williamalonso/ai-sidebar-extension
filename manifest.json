{
  "manifest_version": 3,
  "name": "AI Sidebar Hub",
  "version": "2.0",
  "description": "Sidebar real com múltiplas IAs",
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.chatgpt.com/*",
    "*://chat.openai.com/*",
    "*://gemini.google.com/*",
    "*://chat.deepseek.com/*",
    "*://claude.ai/*",
    "*://copilot.microsoft.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "remover_bloqueio_iframe",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir AI Sidebar"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}